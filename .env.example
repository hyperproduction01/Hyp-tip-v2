# คัดลอกเป็น .env แล้วแก้ค่า
PORT=3000
SITE_NAME=HYP TIP
# อีเมลที่สมัครแล้วจะได้สิทธิ์แอดมิน
ADMIN_EMAIL=purinutchotchuang@gmail.com
# ใช้ตรวจ signature ของ Webhook จาก Payment Gateway (เว้นว่าง = ปิด webhook)
WEBHOOK_SECRET=
# โฟลเดอร์เก็บฐานข้อมูลและสลิป (บน Render ให้ชี้ไปที่ Persistent Disk เช่น /var/data)
DATA_DIR=./data
